.env
.envrc
.venv/
__pycache__/
*.egg-info/
*.duckdb
.mypy_cache/
.ruff_cache/
.pytest_cache/
data/
readings.json

# A local tap config. tap.toml.example is the committed template; the real one
# can hold device credentials and an uplink token, so it must never be added.
tap.toml
# Stray tap buffers outside data/ (e.g. `tap run --buffer-dir ./buf`).
*.sqlite
*.sqlite-wal
*.sqlite-shm

# JetBrains IDE — machine-local files, keep locally, never commit.
.idea/juice.iml
.idea/juice@*.iml
.idea/dataSources.xml
.idea/db-forest-config.xml
.idea/misc.xml
.idea/pyLspTools.xml
.idea/pyProjectModel.xml

# Local DB backup left behind by scripts/sync-prod-to-dev.sh
juice.duckdb.bak

# JS toolchain (jsdom for node --test; deps from package-lock.json)
node_modules/

# Playwright e2e artifacts
test-results/
playwright-report/
playwright/.cache/
tests/e2e/test-results/
tests/e2e/playwright-report/
