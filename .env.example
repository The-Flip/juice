KASA_USERNAME=
KASA_PASSWORD=
FLIPFIX_API_URL=
FLIPFIX_API_KEY=
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_PROVIDER_URL=
OAUTH_REDIRECT_URI=

# Server-side: a long random secret that enables GET /api/backup (full DB
# export). Leave unset to disable the endpoint. Set it in production only.
JUICE_BACKUP_TOKEN=
# Server-side: enables the tap collector's ingest WebSocket at /api/v2/ingest.
# Unset leaves the route unregistered, which is what keeps the receiver inert in
# production until cutover. Must match tap's TAP_UPLINK_TOKEN.
JUICE_INGEST_TOKEN=
# Days of raw readings to keep. Default 90; 0 disables pruning entirely.
# Values below 31 are refused (power baselines read 30 days of raw).
JUICE_RAW_RETENTION_DAYS=
# Client-side (for `make backup` / `make pull-prod`): the production base URL.
JUICE_PROD_URL=https://juice.theflip.museum
